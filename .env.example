# Copy to .env. Values remain on the server and never enter the browser bundle.
# Use the chat-completions compatible endpoint provided by your service.
WONDERLAB_AI_BASE_URL=https://api.deepseek.com
WONDERLAB_AI_KEY=
WONDERLAB_AI_MODEL=deepseek-flash
PORT=8787

# 小诺的在线配音（火山引擎 豆包语音合成大模型 V3）。只需 APP ID 和 Access Token，不需要 Secret Key。
# 音色 ID 和资源 ID 要配对：2.0 音色（*_uranus_bigtts）用 seed-tts-2.0，1.0 音色用 seed-tts-1.0。
WONDERLAB_TTS_APP_ID=
WONDERLAB_TTS_TOKEN=
WONDERLAB_TTS_VOICE=zh_female_vv_uranus_bigtts
WONDERLAB_TTS_RESOURCE_ID=seed-tts-2.0
